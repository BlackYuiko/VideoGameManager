@page
@model VideoGameManager.Pages.Games.EditModel

<h2>Editar Videojoc</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Game.Id" />

            <div class="form-group mb-3">
                <label asp-for="Game.Title" class="control-label">Títol</label>
                <input asp-for="Game.Title" class="form-control" />
                <span asp-validation-for="Game.Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Genre" class="control-label">Gènere</label>
                <input asp-for="Game.Genre" class="form-control" />
                <span asp-validation-for="Game.Genre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Year" class="control-label">Any</label>
                <input asp-for="Game.Year" class="form-control" />
                <span asp-validation-for="Game.Year" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Score" class="control-label">Puntuació</label>
                <input asp-for="Game.Score" class="form-control" />
                <span asp-validation-for="Game.Score" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Game.Description" class="control-label">Descripció</label>
                <textarea asp-for="Game.Description" class="form-control"></textarea>
                <span asp-validation-for="Game.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Desar Canvis</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel·lar</a>
            </div>
        </form>
    </div>
</div>